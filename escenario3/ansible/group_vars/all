# Lista con diccionarios para indicar los datos de los virtualhost que se van a crear:
# apache2
virtualhosts:
  - name: proyecto_manu
    datos:
      nameserver: www.guestbook.org
      documentroot: /var/www/guestbook
      errorlog: error_example
      accesslog: acceses_example
      fastcgi_pass: sardinillas.example.org:9000

# Lista con los módulos que hay que activar
#mods_enabled:
#  - rewrite


# URL del repositorio
guestbook_repo_url: "https://github.com/josedom24/guestbook_php.git"

# Opcional: ruta base donde se alojarán los DocumentRoot
base_web_path: "/var/www/guestbook"


# Variables de conexión a MariaDB para la aplicación guestbook

guestbook_db_host: "geralt.example.org"
guestbook_db_user: "admin_aplicacion"
guestbook_db_password: "usuario"
guestbook_db_name: "admin_guestbook"